# TypeSafe AI (Jev) の API キー。https://typesafe.ai で登録（新規 $5 クレジット）
TYPESAFE_API_KEY=

# モデルは必ずピン留めする。Jev は seed / temperature を持たないので、
# 再現性はバージョン固定 + record/replay キャッシュで担保する。
# 最新を追う場合のみ jev-latest にする（過去のバックテストは再現しなくなる）。
JEV_MODEL=jev-1.13

# 1 にすると API を呼ばず決定論的スタブで動く。配線とバックテストの確認用。
JEV_OFFLINE=0

# ライブループのポーリング間隔（秒）。yfinance は 15 分遅延かつ IP 単位の
# レート制限があるため、短くしすぎると 429 で数時間ブロックされる。
LIVE_POLL_SECONDS=60
