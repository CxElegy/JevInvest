# TypeSafe AI (Jev) の API キー。https://typesafe.ai で登録（新規 $5 クレジット）
TYPESAFE_API_KEY=

# モデルは必ずピン留めする。Jev は seed / temperature を持たないので、
# 再現性はバージョン固定 + record/replay キャッシュで担保する。
# 最新を追う場合のみ jev-latest にする（過去のバックテストは再現しなくなる）。
JEV_MODEL=jev-1.13

# 1 にすると API を呼ばず決定論的スタブで動く。配線とバックテストの確認用。
JEV_OFFLINE=0

# ライブループのポーリング間隔（秒）。yfinance は 15 分遅延かつ IP 単位の
# レート制限があるため、短くしすぎると 429 で数時間ブロックされる。
LIVE_POLL_SECONDS=60

# 注目アカウント（tools/influencers.py）の投稿の取得元。どちらも無ければ投稿を貼って import する。
# X API v2 の Bearer Token。読み取りは有料プランが要る（無料プランでは 403 になる）
X_BEARER_TOKEN=
# X のログイン cookie（auth_token と ct0）。tools/install_x_timeline.sh で bird-search を入れて使う。
# 規約上グレーなので捨てアカウントのものを使う。値はパスワードと同じ扱いで、コミットしない
X_AUTH_TOKEN=
X_CT0=
# 自前の RSSHub・Nitter などの RSS。{handle} が置き換わる
# 例: https://rsshub.example.com/twitter/user/{handle}
TWEETS_RSS_URL=
